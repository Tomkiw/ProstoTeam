# Скопіюйте у .env.local і заповніть. Справжні значення — лише там і в налаштуваннях Vercel.

# Власний домен сайту, напр. https://example.com — задати у Vercel, коли з'явиться.
# Без нього сайт закритий від індексації, а canonical і Open Graph беруть адресу *.vercel.app.
SITE_URL=

# Бот для заявок з форми контактів: токен видає @BotFather
TELEGRAM_BOT_TOKEN=
# Чат, куди бот надсилає заявки (група з ботом або особистий чат)
TELEGRAM_CHAT_ID=

# Капча Cloudflare Turnstile: ключі видає https://dash.cloudflare.com/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
